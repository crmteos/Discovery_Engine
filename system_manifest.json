      },
      "envelope": {
        "schemas": "05_Knowledge_Aggregator/schemas/",
        "src": "05_Knowledge_Aggregator/src/"
      },
      "sub_components": {
        "control_plane": "05_Knowledge_Aggregator/NOTEBOOK_PASSPORT_AGGREGATOR.md",
        "data_plane": "05_Knowledge_Aggregator/CONTEXT_DOMAIN_AGGREGATOR.md",
