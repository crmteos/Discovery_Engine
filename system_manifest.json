        "discovery.symbolic_engineer": "AST/SymPy symbolic regression engine"
      },
      "envelope": {
        "schemas": "01_Formal_Core/src/01_Formal_Ontologies/",
        "src": "01_Formal_Core/src/"
      },
      "sub_components": {
        "symbolic_ai": "01_Formal_Core/src/Symbolic_AI/",
        "discovery_engine": "01_Formal_Core/src/04_Discovery_Engine/",
        "topological_data_analysis": "01_Formal_Core/src/04_Discovery_Engine/Topological_Data_Analysis/",
        "symbolic_regression": "01_Formal_Core/src/04_Discovery_Engine/Symbolic_Regression/",
        "pure_symbolic_engine": "04_Discovery_Engine/src/pure_symbolic_engine.py"
      }
    }
  },
  "node_interaction_rules": {
    "aggregator_isolation": "Node 05 roles (Architect, OSINT_Orchestrator) communicate exclusively via the universal transactional Message Bus (Bridge/bus_manager.py & Bridge/messages.jsonl); node-local bridge/in and bridge/out bindings are removed.",
    "core_exposure": "Node 01 exposes formal ontology contracts via 01_Formal_Core/src/01_Formal_Ontologies/; all core sub-module code is encapsulated under 01_Formal_Core/src/.",
    "target_model_build": "Node 06 synthesizes the mathematically grounded target model from validated triples and reports via the universal Message Bus (Bridge/bus_manager.py); node-local bridge/out bindings are removed.",
    "cross_node_import": "Cross-node Python imports are permitted only via manifest-registered paths under 01_Formal_Core/src/"
  }
}