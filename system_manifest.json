        "knowledge_graphs": "01_Formal_Core/src/Knowledge_Graphs/",
        "symbolic_ai": "01_Formal_Core/src/Symbolic_AI/",
        "neuro_symbolic_bridge": "01_Formal_Core/src/02_NeuroSymbolic_Bridge/",
        "multimodal_interface": "01_Formal_Core/src/03_Multimodal_Interface/",
        "discovery_engine": "01_Formal_Core/src/04_Discovery_Engine/",
        "pure_tda_engine": "01_Formal_Core/src/pure_tda_engine.py",
        "pure_symbolic_engine": "04_Discovery_Engine/src/pure_symbolic_engine.py",
        "pure_rdf_engine": "05_Knowledge_Aggregator/src/pure_rdf_engine.py"
      }
    },
    "node_06_target_model": {
